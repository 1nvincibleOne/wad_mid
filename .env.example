# Copy to .env and set a unique password.
POSTGRES_DB=exchange
POSTGRES_USER=exchange
POSTGRES_PASSWORD=replace_with_a_generated_password

# Host ports (bound to 127.0.0.1)
APP_PORT=8000
ADMINER_PORT=8080

# Add demo instruments (KSPI, HSBK, KZAP, AAPL) when the database is empty
SEED_DEMO_DATA=true
