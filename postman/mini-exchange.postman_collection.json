{
  "info": {
    "name": "Mini Exchange API",
    "description": "Every endpoint of the Mini Exchange. Run the folders in order (or Run collection): later requests use ids saved by earlier ones. Set baseUrl if the API is not on port 8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "description": "",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Database ok\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Instruments",
      "description": "",
      "item": [
        {
          "name": "Create instrument",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/instruments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ]
            },
            "description": "Lists a new instrument. A random symbol is generated so the collection can be run many times.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"name\": \"Demo Holdings\",\n  \"currency\": \"KZT\",\n  \"tick_size\": \"0.5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"symbol\", \"D\" + Math.floor(Math.random() * 1e6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"instrumentId\", body.id);",
                  "pm.test(\"Symbol saved\", () => pm.expect(body.symbol).to.eql(pm.collectionVariables.get(\"symbol\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "List instruments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?is_active=true&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "is_active",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"New instrument listed\", () => pm.expect(pm.response.json().map(i => i.id)).to.include(pm.collectionVariables.get(\"instrumentId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get instrument by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments/{{instrumentId}}",
              "host": [
