              "raw": "{{baseUrl}}/orders/{{aliceOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{aliceOrderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test(\"Partially filled\", () => {",
                  "    pm.expect(order.status).to.eql(\"partially_filled\");",
                  "    pm.expect(order.remaining_quantity).to.eql(30);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update order (amend price)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{aliceOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{aliceOrderId}}"
              ]
            },
            "description": "Changing the price sends the order to the back of the queue at its new price.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": \"1000.5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"New price\", () => pm.expect(Number(pm.response.json().order.price)).to.eql(1000.5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete order (cancel)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{aliceOrderId}}",
              "host": [
