    {
      "name": "Orders and matching",
      "description": "",
      "item": [
        {
          "name": "Place sell order (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrument_id\": {{instrumentId}},\n  \"trader\": \"alice\",\n  \"side\": \"sell\",\n  \"price\": \"1000\",\n  \"quantity\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"aliceOrderId\", body.order.id);",
                  "pm.test(\"Rests in the book\", () => { pm.expect(body.order.status).to.eql(\"open\"); pm.expect(body.trades).to.have.length(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Place sell order (bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrument_id\": {{instrumentId}},\n  \"trader\": \"bob\",\n  \"side\": \"sell\",\n  \"price\": \"999.5\",\n  \"quantity\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"bobOrderId\", pm.response.json().order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Place buy order that matches (carol)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Crosses the book: buys bob's cheaper 50 first, then 70 of alice's 100.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrument_id\": {{instrumentId}},\n  \"trader\": \"carol\",\n  \"side\": \"buy\",\n  \"price\": \"1000\",\n  \"quantity\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"carolOrderId\", body.order.id);",
                  "pm.collectionVariables.set(\"tradeId\", body.trades[0].id);",
                  "pm.test(\"Fully filled by two trades\", () => {",
                  "    pm.expect(body.order.status).to.eql(\"filled\");",
                  "    pm.expect(body.trades).to.have.length(2);",
                  "});",
                  "pm.test(\"Best price first: bob 50 @ 999.5, then alice 70 @ 1000\", () => {",
                  "    pm.expect(Number(body.trades[0].price)).to.eql(999.5);",
                  "    pm.expect(body.trades[0].quantity).to.eql(50);",
                  "    pm.expect(Number(body.trades[1].price)).to.eql(1000);",
                  "    pm.expect(body.trades[1].quantity).to.eql(70);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments/{{instrumentId}}/book?depth=10",
              "host": [
